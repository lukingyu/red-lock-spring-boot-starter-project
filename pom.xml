<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.lukingyu</groupId>
    <artifactId>red-lock-spring-boot-starter-project</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Red Lock Spring Boot Starter</name>
    <description>Spring Boot starter for Redis-based idempotency protection.</description>
    <url>https://github.com/lukingyu/red-lock-spring-boot-starter-project</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>lukingyu</id>
            <name>lukingyu</name>
            <url>https://github.com/lukingyu</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/lukingyu/red-lock-spring-boot-starter-project.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/lukingyu/red-lock-spring-boot-starter-project.git</developerConnection>
        <url>https://github.com/lukingyu/red-lock-spring-boot-starter-project</url>
    </scm>

    <modules>
        <module>red-lock-spring-boot-autoconfigure</module>
        <module>red-lock-spring-boot-starter</module>
        <module>red-lock-sample</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-boot.version>3.5.10</spring-boot.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
